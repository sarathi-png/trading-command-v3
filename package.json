{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm --prefix trading-gateway run typecheck",
    "test:quant": "tsc -p tsconfig.quant.json && node --test output/quant-js/lib/strategy/quant/quant.test.js",
    "test:quant:v2": "tsc -p tsconfig.quant.v2.json && node --test output/quant-v2-js/lib/strategy/v2/*.test.js",
    "test:ai": "tsc -p tsconfig.ai.json && node --test output/ai-js/lib/ai/*.test.js",
    "test:paper": "node --test tests/paper-api.test.mjs",
    "test": "npm run test:features && npm run test:auth && npm run test:quant && npm run test:quant:v2 && npm run test:ai && npm run test:exchange && npm run test:gateway && npm run build && npm run test:paper && npm run test:live-exchange",
    "test:gateway": "npm --prefix trading-gateway test",
    "test:exchange": "tsc -p tsconfig.exchange.json && node --test output/exchange-js/tests/exchange/coindcx.test.js",
    "test:live-exchange": "node --test tests/live-exchange.test.mjs",
    "test:safety": "tsc -p tsconfig.safety.json && node --test output/safety-js/lib/risk.test.js output/safety-js/lib/market/validate.test.js output/safety-js/lib/cache.test.js output/safety-js/lib/data/provider.test.js output/safety-js/lib/chart/overlays.test.js output/safety-js/lib/analytics/metrics.test.js output/safety-js/lib/exchange/coindcx/timeframes.test.js output/safety-js/lib/integrations/tradingview/payload.test.js output/safety-js/lib/signalId.test.js",
    "test:auth": "tsc -p tsconfig.auth.json && node --test output/auth-js/lib/auth.test.js",
    "test:features": "tsc -p tsconfig.features.json && node --test output/features-js/lib/notifications/*.test.js output/features-js/lib/market/movers.test.js output/features-js/lib/journal/core.test.js output/features-js/lib/displayCurrency.test.js output/features-js/lib/exchange/liveWallet.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.29",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}

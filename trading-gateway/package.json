{
  "name": "trading-command-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Static-IP trading gateway: authenticated Delta Exchange India private API and live order execution for Trading Command V3.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node --watch dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/**/*.test.js\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}

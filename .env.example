# ===========================================================================
# Trading Command V3 — VERCEL (application) environment
#
# This file documents what the Next.js application needs. The Delta Exchange
# India API key and secret are NOT here: after the static-IP gateway migration
# they exist only on the gateway host (see trading-gateway/.env.example).
# Nothing in this file may be prefixed NEXT_PUBLIC_.
# ===========================================================================

# ---- Core ----------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# DATA_BACKEND=postgres          # optional: force "postgres" (default) or "file"

# ---- API authentication (REQUIRED before ANY trading) --------------------
# Every /api route is authenticated by proxy.ts. If API_PASSWORD is unset the
# API refuses to serve anything (HTTP 503) — it never falls open.
# Use a long random value, e.g. `openssl rand -hex 32`.
API_PASSWORD=
# Signs the session cookie. Set this separately from the password so a leaked
# cookie does not reveal the login secret. Falls back to API_PASSWORD if empty.
SESSION_SECRET=

# ---- Static-IP Trading Gateway (REQUIRED for private Delta data & orders) -
# The gateway is the ONLY component that talks to Delta with credentials, and
# it is the only component with a dedicated outbound IPv4 to allowlist at
# Delta. Generate the secret with `openssl rand -hex 32` and use the SAME value
# in the gateway's TRADING_GATEWAY_SECRET.
# NEVER prefix these with NEXT_PUBLIC_ — that would ship them to the browser.
TRADING_GATEWAY_URL=https://gateway.example.com
TRADING_GATEWAY_SECRET=
# Optional: request timeout in ms for gateway calls (default 12000).
# TRADING_GATEWAY_TIMEOUT_MS=12000

# ---- Public Delta market data (no credentials required) ------------------
# Tickers, candles, order book and trades stay on the application: they need no
# API key and no static IP, so they are deliberately NOT routed through the
# gateway.
DELTA_MARKET_ENABLED=true
# Optional public-endpoint overrides
# DELTA_REST_BASE=https://api.india.delta.exchange
# DELTA_WS_URL=wss://socket.india.delta.exchange

# ---- Feature flags (sensitive capabilities default OFF) -----------------
# LIVE_EXECUTION_ENABLED also has to be true on the GATEWAY, and live orders
# additionally require a verifiable daily P&L (not implemented — see
# trading-gateway/src/risk/dailyPnl.ts), so this flag alone cannot enable live
# trading.
LIVE_EXECUTION_ENABLED=false
PAPER_TRADING_ENABLED=true
TRADINGVIEW_WEBHOOK_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=
ORDERBOOK_ENABLED=true
STRATEGY_ENGINE_ENABLED=true
AUTO_S_R_ENABLED=true
JOURNAL_ENABLED=true
ANALYTICS_ENABLED=true
TELEGRAM_ENABLED=false

# ---- Optional display/infrastructure ------------------------------------
# USD_INR_RATE=88
# REDIS_URL=

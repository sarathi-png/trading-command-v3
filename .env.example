# ===========================================================================
# Trading Command V3 — application environment
#
# This file documents what the Next.js application needs. The CoinDCX API key
# and secret ARE here: the API routes sign CoinDCX requests themselves, so the
# credentials live in this deployment's environment. There is no gateway host,
# no VPS and no static IP to arrange (see docs/COINDCX_SETUP.md §1).
#
# Nothing in this file may be prefixed NEXT_PUBLIC_ — that would ship it to the
# browser. Full deployment steps: docs/VERCEL_DEPLOYMENT.md
# ===========================================================================

# ---- Core ----------------------------------------------------------------
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# DATA_BACKEND=postgres          # optional: force "postgres" (default) or "file"

# ---- API authentication (REQUIRED before ANY trading) --------------------
# Every /api route is authenticated by proxy.ts. If API_PASSWORD is unset the
# API refuses to serve anything (HTTP 503) — it never falls open.
# Use a long random value, e.g. `openssl rand -hex 32`.
API_PASSWORD=
# Signs the session cookie. Set this separately from the password so a leaked
# cookie does not reveal the login secret. Falls back to API_PASSWORD if empty.
SESSION_SECRET=

# ---- CoinDCX (REQUIRED for private account data and live orders) ---------
# Created at CoinDCX → API Dashboard. Leave "Bind IP Address" UNCHECKED: Vercel
# functions have no fixed egress address, and CoinDCX does not require binding
# for futures keys. A read-only key is enough to verify the connection; live
# orders need a key with futures TRADING permission. Never enable withdrawal
# permissions for this app.
#
# The secret is shown once at creation — store it here and nowhere else. It is
# read only by server code, never logged, never stored in the database and never
# sent to the browser.
COINDCX_API_KEY=
COINDCX_API_SECRET=
# Optional hosts (defaults shown). Overriding them is mainly for tests, which
# point them at a local mock venue.
# COINDCX_BASE_URL=https://api.coindcx.com
# COINDCX_PUBLIC_BASE_URL=https://public.coindcx.com
# EXCHANGE_NAME=coindcx

# ---- Public market data (no credentials required) ------------------------
# Tickers, candles, order book and trades need no API key, so they work even
# with no credentials configured.
EXCHANGE_MARKET_ENABLED=true
# Legacy alias still honoured if the new name is absent:
# DELTA_MARKET_ENABLED=true

# ---- Feature flags (sensitive capabilities default OFF) ------------------
# Live orders additionally require LIVE mode to be armed in the UI AND a daily
# realised P&L that can be proven from CoinDCX. That figure fails closed, so this
# flag alone cannot enable trading, and an unverifiable day blocks submission.
LIVE_EXECUTION_ENABLED=false
PAPER_TRADING_ENABLED=true
TRADINGVIEW_WEBHOOK_ENABLED=false
TRADINGVIEW_WEBHOOK_SECRET=
ORDERBOOK_ENABLED=true
STRATEGY_ENGINE_ENABLED=true
AUTO_S_R_ENABLED=true
JOURNAL_ENABLED=true
ANALYTICS_ENABLED=true
TELEGRAM_ENABLED=false

# ---- Optional display/infrastructure ------------------------------------
# USD_INR_RATE=88
# REDIS_URL=

# --------------------------------------------------------------------------
# RETIRED — ignored by this application. Delete them if they are still set:
#   TRADING_GATEWAY_URL / TRADING_GATEWAY_SECRET   (the old static-IP gateway)
#   DELTA_API_KEY / DELTA_API_SECRET               (the old venue)
# The gateway service still exists in trading-gateway/ for Delta-era
# deployments, but nothing in this app calls it.
# --------------------------------------------------------------------------
